// Admonition box: `#admonition(kind, icon, title)[body]`, generated by common/gfm_admonition.lua.
// Same colors as the LaTeX boxes: colored title bar, light background.
#let admonition-styles = (
  note: (frame: rgb(0, 0, 191), title: white),
  tip: (frame: rgb(0, 153, 0), title: white),
  important: (frame: rgb(179, 89, 0), title: white),
  warning: (frame: rgb(191, 0, 0), title: white),
  caution: (frame: rgb(179, 179, 0), title: black),
)

#let admonition(kind, icon, title, body) = {
  let style = admonition-styles.at(kind)
  block(width: 100%, breakable: true, stroke: 1pt + style.frame, radius: 3pt, clip: true, fill: style.frame.lighten(95%), {
    set par(first-line-indent: 0pt)
    // sticky: the title is not left alone at the bottom of a page
    block(sticky: true, width: 100%, fill: style.frame, inset: (x: 8pt, y: 4pt), below: 0pt, text(fill: style.title)[#icon #title])
    block(width: 100%, inset: 8pt, above: 0pt, body)
  })
}
